# The standalone relay. Built on every pull request and published by
# deploy-aws.yml as an immutable SHA image under the reviewed-image pin; it
# serves traffic only once an oxy-infra change pins a reviewed digest, sets its
# secrets and scales the service up (docs/architecture/relays.md §8).
#
# The digest is what the build uses; the tag is for readers (see Dockerfile.api).
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
WORKDIR /app

# The hoisted linker, or bun nests dependencies under each workspace and the
# runtime cannot resolve them from the root.
COPY bunfig.toml ./
COPY package.json bun.lock ./

# Every workspace manifest: bun resolves the whole workspace graph before
# installing anything, so one missing package.json fails the install.
COPY apps/api/package.json apps/api/
COPY apps/dns-server/package.json apps/dns-server/
COPY apps/exit/package.json apps/exit/
COPY apps/relay/package.json apps/relay/
COPY apps/web/package.json apps/web/
COPY packages/client/package.json packages/client/
COPY packages/crypto/package.json packages/crypto/
COPY packages/namespace/package.json packages/namespace/
COPY packages/protocol/package.json packages/protocol/
COPY packages/relay-core/package.json packages/relay-core/
COPY packages/shared-types/package.json packages/shared-types/

# Production dependencies of the relay only; see Dockerfile.api.
RUN bun install --frozen-lockfile --production --omit=peer --filter @tnp/relay

# The relay and every workspace package it imports at runtime.
COPY apps/relay apps/relay
COPY packages/crypto packages/crypto
COPY packages/protocol packages/protocol
COPY packages/relay-core packages/relay-core
COPY packages/shared-types packages/shared-types

ENV NODE_ENV=production
ENV RELAY_PORT=8080
EXPOSE 8080

# Lets the deploy target tell "the process is up" from "the process can answer".
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.RELAY_PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# The base image's unprivileged `bun` user, as in Dockerfile.api: the relay binds
# a high port, and its code and node_modules stay root-owned and read-only.
USER bun

# Required at run time (apps/relay/src/config.ts): RELAY_ENDPOINT, the public
# wss:// URL the signed directory lists, and RELAY_KEY_SEED, the relay key's
# base64 32-byte Ed25519 seed (SSM SecureString via the task's `secrets`).
# `--check-config` validates both without binding a port.
CMD ["bun", "apps/relay/src/index.ts"]

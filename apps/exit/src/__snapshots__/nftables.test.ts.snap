// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the exit ruleset matches the reviewed snapshot 1`] = `
"#!/usr/sbin/nft -f
# TNP exit packet filter. Generated by @tnp/exit (apps/exit/src/nftables.ts); do not edit.
# No rule here logs. Counters are aggregate only.

table inet tnp_exit
delete table inet tnp_exit

table inet tnp_exit {
  set blocked_v4 {
    type ipv4_addr
    flags interval
    auto-merge
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 172.31.0.0/16 }
  }

  set blocked_v6 {
    type ipv6_addr
    flags interval
    auto-merge
    elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001:db8::/32, 2002::/16, fc00::/7, fe80::/10, ff00::/8 }
  }

  set dns_v4 {
    type ipv4_addr
    elements = { 198.51.100.53 }
  }

  set dns_rate {
    type ipv4_addr
    size 65536
    flags dynamic,timeout
    timeout 1m
  }

  counter forwarded {}
  counter refused_private {}
  counter refused_port {}
  counter refused_ipv6 {}
  counter refused_dns_rate {}

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state invalid drop
    ct state established,related accept
    iifname "ens5" udp dport 51820 accept
    iifname "ens5" udp sport 67 udp dport 68 accept
    iifname "ens5" udp sport 547 udp dport 546 accept
    meta nfproto ipv4 icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 50/second accept
    meta nfproto ipv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    tcp flags syn tcp option maxseg size set rt mtu
    ct state invalid drop
    ct state established,related accept
    iifname != "wg0" drop
    ip saddr != 10.77.0.0/16 drop
    oifname != "ens5" counter name refused_private reject with icmpx type admin-prohibited
    ip6 daddr @blocked_v6 counter name refused_private reject with icmpx type admin-prohibited
    meta nfproto ipv6 counter name refused_ipv6 reject with icmpx type admin-prohibited
    ip daddr @blocked_v4 counter name refused_private reject with icmpx type admin-prohibited
    tcp dport { 25, 137, 139, 445 } counter name refused_port reject with tcp reset
    udp dport { 137, 138 } counter name refused_port reject with icmpx type admin-prohibited
    ip daddr @dns_v4 udp dport 53 add @dns_rate { ip saddr limit rate over 50/second burst 200 packets } counter name refused_dns_rate drop
    oifname "ens5" counter name forwarded accept
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "ens5" ip saddr 10.77.0.0/16 masquerade
  }
}
"
`;

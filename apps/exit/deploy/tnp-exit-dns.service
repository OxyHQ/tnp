[Unit]
Description=TNP exit resolver: TNP's DNS for this exit's peers, on the tunnel gateway only
Documentation=https://github.com/OxyHQ/tnp/blob/main/docs/architecture/exit-nodes.md
# It binds the gateway address wg-up.sh puts on wg0, so it starts after wg0 is
# up and stops (or restarts) with it.
Requires=tnp-exit-wg.service
After=tnp-exit-wg.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tnp-exit-dns
Group=tnp-exit-dns
# TNP_API_URL and TNP_UPSTREAM_DNS (the exit's DoH upstreams), from bootstrap.sh.
EnvironmentFile=/etc/tnp-exit/dns.env
Environment=NODE_ENV=production
# The tunnel gateway address (VPN_EXIT_TUNNEL_IPV4) and nothing else: reachable
# only from peers through wg0, never from the internet (and the packet filter
# admits port 53 from wg0 to this address only).
Environment=TNP_LISTEN_ADDR=10.77.0.1
Environment=TNP_LISTEN_PORT=53
Environment=TNP_TLD_CACHE_PATH=/var/lib/tnp-exit-dns/tlds.json
Environment=PATH=/usr/bin:/usr/sbin
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# The same resolver as TNP's public one (apps/dns-server): native names from
# the registry, public names over DoH, per-source rate limiting (sources here
# are peer tunnel addresses), no query log.
ExecStart=/opt/tnp-exit/bin/bun --no-install /opt/tnp-exit/src/apps/dns-server/src/index.ts
Restart=always
RestartSec=2
StateDirectory=tnp-exit-dns
StateDirectoryMode=0700

# Binding port 53 needs CAP_NET_BIND_SERVICE and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
# It needs the TNP API and its DoH upstreams over HTTPS. Never the instance
# metadata service.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target

DATABASE_URL=postgresql://postgres:tnp@localhost:5434/tnp
OXY_API_URL=https://api.oxy.so
PORT=3000
NODE_ENV=development

# Native name expiry enforcement (docs/architecture/naming.md §4). Off unless
# exactly "true". When on, a native name more than 30 days past its expiry stops
# resolving and its parking page says "expired, held"; it is never released to
# anyone else. Leave off until owners have been told their names expire.
TNP_NATIVE_EXPIRY_ENFORCED=false

# Optional services layer (docs/architecture/services.md). Every flag is off
# unless set to 1 or true, and TNP Network needs none of them.
# TNP_SERVICES_CATALOG=
# TNP_SERVICES_SALES=
# TNP_SERVICES_DNS_WRITE=
# TNP_SERVICES_WORKER=
# TNP_SERVICES_ENVIRONMENT=sandbox
# TNP_SERVICES_WORKER_CONCURRENCY=2
# TNP_SERVICES_WORKER_POOL_SIZE=4
# Provider secrets are referenced from provider_accounts.secret_ref (env:NAME),
# never stored in the database, e.g.:
# NAMECHEAP_SANDBOX_API_KEY=

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declaration": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src",
    "test-db"
  ]
}

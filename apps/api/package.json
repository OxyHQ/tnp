{
  "name": "@tnp/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "seed": "bun src/seed.ts",
    "test": "bun test src",
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=6 --hot-tables=dns_records,domains,relays,service_nodes,users,vpn_devices",
    "typecheck": "tsc --noEmit",
    "test:db": "bun test test-db",
    "worker:services": "bun src/workers/commerce.ts",
    "test:sandbox:namecheap": "bun test test-sandbox"
  },
  "dependencies": {
    "@oxy.so/core": "7.0.0",
    "@oxy.so/db": "1.4.0",
    "@oxy.so/utils": "^1.3.0",
    "@tnp/crypto": "workspace:*",
    "@tnp/namespace": "workspace:*",
    "@tnp/protocol": "workspace:*",
    "@tnp/shared-types": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "postgres": "3.4.9",
    "@aws-sdk/credential-provider-node": "3.972.84"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "bun-types": "^1.4.3",
    "drizzle-kit": "0.31.10",
    "typescript": "~7.0.2"
  }
}

# Pinned for the same reason as Dockerfile.api: the lockfile is consumed here
# and in CI, and a version mismatch reads as a dependency problem when it is a
# tooling one.
#
# The digest is what the build uses; the tag is for readers. Moving to another
# Bun (or picking up a rebuilt 1.4.3) needs a new multi-arch index digest and a
# re-review of the reviewed-image pin.
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
WORKDIR /app

# The hoisted linker, or bun nests dependencies under each workspace and the
# runtime cannot resolve them from the root.
COPY bunfig.toml ./
COPY package.json bun.lock ./

# Every workspace manifest, because bun resolves the whole workspace graph
# before installing anything. This image built with only two of them until
# `packages/client` gained workspace dependencies, at which point the install
# started failing with "@tnp/namespace@workspace:* failed to resolve" — and
# nothing noticed, because no workflow builds this Dockerfile.
COPY apps/api/package.json apps/api/
COPY apps/dns-server/package.json apps/dns-server/
COPY apps/relay/package.json apps/relay/
COPY apps/web/package.json apps/web/
COPY packages/client/package.json packages/client/
COPY packages/crypto/package.json packages/crypto/
COPY packages/namespace/package.json packages/namespace/
COPY packages/protocol/package.json packages/protocol/
COPY packages/relay-core/package.json packages/relay-core/
COPY packages/shared-types/package.json packages/shared-types/

RUN bun install --frozen-lockfile

# Source for the resolver and every workspace package it reaches. `apps/dns-server`
# still imports `packages/client` by relative path (audit B1), so the client's own
# workspace dependencies have to be here too.
COPY packages/client packages/client
COPY packages/crypto packages/crypto
COPY packages/namespace packages/namespace
COPY packages/protocol packages/protocol
COPY packages/shared-types packages/shared-types
COPY apps/dns-server apps/dns-server

ENV NODE_ENV=production
# The image defaults to 5353, but production sets TNP_LISTEN_PORT=53
# (oxy-infra app-tnp.tf), and binding a port below 1024 needs root here. So this
# image still runs as root; moving production to 5353 behind the NLB is what lets
# it drop to the base image's `bun` user.
EXPOSE 5353/udp
EXPOSE 5353/tcp

CMD ["bun", "apps/dns-server/src/index.ts"]

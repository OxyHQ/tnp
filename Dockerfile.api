# Bun is pinned, not `latest`. The lockfile is consumed here and in CI, and a
# version mismatch between the two produces "lockfile had changes, but lockfile
# is frozen" at build time — a failure that reads as a dependency problem and is
# not.
#
# The digest is what the build uses; the tag is for readers. Moving to another
# Bun (or picking up a rebuilt 1.4.3) needs a new multi-arch index digest and a
# re-review of the reviewed-image pin.
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
WORKDIR /app

# The hoisted linker, or bun nests dependencies under each workspace and the
# runtime cannot resolve them from the root.
COPY bunfig.toml ./
COPY package.json bun.lock ./

# Every workspace manifest, because bun resolves the whole workspace graph
# before installing anything. One missing package.json fails the install with
# "@tnp/<name>@workspace:* failed to resolve", however unrelated that workspace
# is to the API.
COPY apps/api/package.json apps/api/
COPY apps/dns-server/package.json apps/dns-server/
COPY apps/relay/package.json apps/relay/
COPY apps/web/package.json apps/web/
COPY packages/client/package.json packages/client/
COPY packages/crypto/package.json packages/crypto/
COPY packages/namespace/package.json packages/namespace/
COPY packages/protocol/package.json packages/protocol/
COPY packages/relay-core/package.json packages/relay-core/
COPY packages/shared-types/package.json packages/shared-types/

# Production dependencies of the API's workspace graph only. `--filter` leaves out
# the other workspaces (the web app's React Native tree above all), `--production`
# every devDependency (typescript, drizzle-kit, biome, bun-types), and
# `--omit=peer` the peers bun would otherwise install because the web app put
# them in the lockfile: @oxy.so/core's optional React Native/Expo peers. Nothing
# the API imports at runtime is a devDependency or a peer it does not also
# declare itself (express is a direct dependency). About 55 MB of node_modules
# instead of 1.4 GB.
RUN bun install --frozen-lockfile --production --omit=peer --filter @tnp/api

# Source for the API and every workspace package it imports at runtime. Bun runs
# the TypeScript directly, so the source is the artefact — a build step would
# only add a way for the two to diverge.
COPY apps/api apps/api
COPY packages/crypto packages/crypto
COPY packages/namespace packages/namespace
COPY packages/shared-types packages/shared-types

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

# Lets the deploy target tell "the process is up" from "the process can answer".
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# The base image's unprivileged `bun` user (uid 1000). Everything above is owned
# by root and only readable here: the API binds 8080 and writes nothing to disk.
USER bun

CMD ["bun", "apps/api/src/index.ts"]

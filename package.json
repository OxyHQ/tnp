{
  "name": "tnp",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --no-exit-on-error dev:api dev:web",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "seed": "cd apps/api && bun run seed",
    "typecheck": "bun run --filter '*' typecheck",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "validate:boundaries": "bun ./scripts/check-import-boundaries.ts && bun ./scripts/test-check-import-boundaries.ts",
    "test": "bun run --filter '*' test",
    "test:db": "bun run --filter '@tnp/api' test:db",
    "release": "release-it",
    "test:web-worker": "bun test scripts/web-worker.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "release-it": {
    "git": {
      "tagName": "tnp@${version}",
      "tagAnnotation": "Release tnp@${version}",
      "commitMessage": "chore: release tnp@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "tnp@${version}"
    },
    "npm": {
      "publish": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "release-it": "^20.2.1"
  },
  "overrides": {
    "@oxy.so/telemetry": "1.2.0",
    "@oxy.so/contracts": "4.24.0",
    "@oxy.so/core": "4.21.1",
    "@oxy.so/protocol": "1.3.0",
    "@oxy.so/services": "11.12.1",
    "@oxy.so/bloom": "10.16.0"
  },
  "resolutions": {
    "@oxy.so/telemetry": "1.2.0"
  }
}
